	measure 'Frais conv €' = CALCULATE(SUM('Activité chauffeur'[Coût]), 'Activité chauffeur'[Libellé] = "Frais conv")
		formatString: #,0 €
		displayFolder: Heures conducteurs
		lineageTag: adcf965d-769a-5816-8a59-0fbee6b2b9b7

	measure 'Frais non-conv €' = CALCULATE(SUM('Activité chauffeur'[Coût]), 'Activité chauffeur'[Libellé] = "Frais non-conv")
		formatString: #,0 €
		displayFolder: Heures conducteurs
		lineageTag: 37100b54-c8dd-5d11-a859-3da6cfe1d93e

	measure 'Frais conv / HP' = DIVIDE([Frais conv €], [Heures prod])
		formatString: #,0.00 €
		displayFolder: Heures conducteurs
		lineageTag: b0ab0c2b-72b8-5e3a-8dea-32685d37013b

	measure 'Frais non-conv / HP' = DIVIDE([Frais non-conv €], [Heures prod])
		formatString: #,0.00 €
		displayFolder: Heures conducteurs
		lineageTag: 0bc1d934-faa0-5387-a8e6-f92f422d3cc4

	measure 'Frais & primes / HP' = [Frais conv / HP] + [Frais non-conv / HP]
		formatString: #,0.00 €
		displayFolder: Heures conducteurs
		lineageTag: 65e457a7-40b4-570e-a581-620ec38c6e08

	measure 'Heures formation' = CALCULATE(SUM('Activité chauffeur'[Heures]), 'Activité chauffeur'[Catégorie] = "Formation")
