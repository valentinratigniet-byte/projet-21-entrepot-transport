		displayFolder: Heures conducteurs
		lineageTag: b6f49dfe-b551-56fa-a28d-e8b1396381a0

	measure '% heures hors carte / heures prod' = DIVIDE([Heures hors carte], [Heures prod])
		formatString: 0.0%
