	measure 'Coût formation €' = CALCULATE(SUM('Activité chauffeur'[Coût]), 'Activité chauffeur'[Catégorie] = "Formation")
		formatString: #,0 €
		displayFolder: Heures conducteurs
		lineageTag: 2769c2a8-abd2-553b-a821-d32831d751a9

	measure 'Heures trajets' = CALCULATE(SUM('Activité chauffeur'[Heures]), 'Activité chauffeur'[Catégorie] = "Trajet")
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: c260c03d-7956-59e6-8fea-536d9ec71cc5

	measure 'Coût trajets €' = CALCULATE(SUM('Activité chauffeur'[Coût]), 'Activité chauffeur'[Catégorie] = "Trajet")
		formatString: #,0 €
		displayFolder: Heures conducteurs
		lineageTag: 7410b9df-1797-57d6-b7df-bceb62ff50cd

	measure 'Lignes en attente de vérification' = CALCULATE(COUNTROWS('Activité chauffeur'), 'Activité chauffeur'[Est en attente vérification])
		formatString: #,0
		displayFolder: Heures conducteurs
		lineageTag: 7ba42153-3179-5e81-9000-0f5c43ed0e67

	measure 'Heures payées' = SUM('Compteur paie'[Heures payées])
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 7a92828d-27e4-5540-a9f0-4f1090cecfbf

	measure 'Heures réalisées (paie)' = SUM('Compteur paie'[Heures réalisées])
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 3011c449-9d14-54d3-b643-6fde84542a1f

	measure 'Heures payées / mois' = AVERAGEX(VALUES('Conducteur'[Matricule]), DIVIDE(CALCULATE(SUM('Compteur paie'[Heures payées])), CALCULATE(DISTINCTCOUNT('Compteur paie'[Mois]))))
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 31692d2d-7486-5921-a3b1-35081db42add

	measure 'Écart moyen heures payées' =
			VAR moyenne = CALCULATE([Heures payées / mois], ALLSELECTED('Conducteur'))
			RETURN AVERAGEX(FILTER(VALUES('Conducteur'[Matricule]), NOT ISBLANK([Heures payées / mois])), ABS([Heures payées / mois] - moyenne))
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: b48f4e2f-01f7-5243-80d1-b84781364fe4

	measure 'Heures réalisées moyennes / conducteur' = CALCULATE(DIVIDE([Heures réalisées (paie)], DISTINCTCOUNT('Compteur paie'[Matricule])), ALLSELECTED('Conducteur'))
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 9e96819d-da95-547f-8347-829fe3ef840f

	measure 'Écart moyen heures réalisées' = AVERAGEX(FILTER(VALUES('Conducteur'[Matricule]), NOT ISBLANK(CALCULATE([Heures réalisées (paie)]))), ABS(CALCULATE([Heures réalisées (paie)]) - [Heures réalisées moyennes / conducteur]))
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: d56d3889-4361-58b9-a0df-242021d01a1e

	measure 'Heures réalisées mois en cours' =
			VAR ref = [Date de référence]
			RETURN CALCULATE(SUM('Chrono'[Heures service]), REMOVEFILTERS('Date'), 'Date'[Date] >= DATE(YEAR(ref), MONTH(ref), 1), 'Date'[Date] <= ref - 1)
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: b9ddf5d4-a972-5b94-980a-58ff664db259

	measure 'Moyenne heures / jour' =
			VAR ref = [Date de référence]
			RETURN DIVIDE([Heures réalisées mois en cours], CALCULATE(DISTINCTCOUNT('Chrono'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] >= DATE(YEAR(ref), MONTH(ref), 1), 'Date'[Date] <= ref - 1))
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 1d11f7f8-49dc-58bd-a761-494af1da2f64

	measure 'Jours restants' =
			VAR ref = [Date de référence]
			RETURN NETWORKDAYS(ref, EOMONTH(ref, 0))
		formatString: 0
		displayFolder: Heures conducteurs
		lineageTag: 02670951-35f1-5aa5-9f27-424af5779c5d

	measure 'Jours ouvrés restants' =
			VAR ref = [Date de référence]
			RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Date] >= ref, 'Date'[Date] <= EOMONTH(ref, 0), 'Date'[Est jour ouvré])
		formatString: 0
		displayFolder: Heures conducteurs
		lineageTag: 70c25b08-b07f-54f0-90cf-3562b9546cbd

	measure 'Projection fin de mois' = [Heures réalisées mois en cours] + [Moyenne heures / jour] * [Jours restants]
		formatString: #,0
		displayFolder: Heures conducteurs
		lineageTag: 3c5c3dae-5d57-5e38-9586-af9b33a30e17

	measure 'Projection fin de mois hors fériés' = [Heures réalisées mois en cours] + [Moyenne heures / jour] * [Jours ouvrés restants]
		formatString: #,0
		displayFolder: Heures conducteurs
		lineageTag: 6d63abe5-e4d0-543a-9442-d0a4db5dcb44

	measure 'Reste à faire' = [Projection fin de mois] - [Heures réalisées mois en cours]
		formatString: #,0
		displayFolder: Heures conducteurs
		lineageTag: 47fe07d6-2b41-5491-a014-efa2e3c57f69

	measure 'Nb jours-tracteur' = CALCULATE(COUNTROWS('Affectation'), NOT 'Affectation'[Est maintenance])
		formatString: #,0
		displayFolder: Parc
		lineageTag: a84eb1cd-4ff1-5d20-ad19-219c2831685f

	measure 'Nb tracteurs / jour ouvré' = DIVIDE([Nb jours-tracteur], [Jours ouvrés])
		formatString: #,0.0
		displayFolder: Parc
		lineageTag: f971370c-e49d-57dd-926b-9b95a021ef02

	measure 'Nb tracteurs / jour ouvré N-1' = CALCULATE([Nb tracteurs / jour ouvré], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0.0
