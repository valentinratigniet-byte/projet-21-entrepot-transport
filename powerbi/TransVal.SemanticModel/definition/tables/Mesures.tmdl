		lineageTag: d7c250db-f690-5211-9b6a-5c35d74b868a

	measure 'Sélection heures hors carte' = SWITCH(SELECTEDVALUE('Vue heures'[Vue], "€/HP"), "€/HP", [Coût heure hors carte / HP], "Heures", [Heures hors carte], "€", [Heures hors carte €])
		formatString: #,0.00
		displayFolder: Sélecteurs
		lineageTag: 3a507e31-d86a-5659-9009-99fd6f17e1f8

	measure 'Sélection heures à justifier' = SWITCH(SELECTEDVALUE('Vue heures'[Vue], "€/HP"), "€/HP", [Heures à justifier payées € / HP], "Heures", [Heures à justifier payées], "€", [Heures à justifier payées €])
		formatString: #,0.00
		displayFolder: Sélecteurs
		lineageTag: 6646cc64-c461-504a-86c4-7b4f2bc019d7

	measure 'Sélection heures compensées' = SWITCH(SELECTEDVALUE('Vue heures'[Vue], "€/HP"), "€/HP", [Heures compensées € / HP], "Heures", [Heures compensées (base contrat)], "€", [Heures compensées €])
		formatString: #,0.00
		displayFolder: Sélecteurs
		lineageTag: f3cad8ef-1086-586c-a6d3-8c8785762af7

	measure 'CA (tracteurs)' = SUM('Rentabilité tracteur'[CA])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 3dd26321-db7e-58ec-9968-d75f80024918

	measure 'Péages réels' = SUM('Rentabilité tracteur'[Péages])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: a4d78756-1e7b-5b3a-b461-318f0c47acd5

	measure 'Carburant réel' = SUM('Rentabilité tracteur'[Carburant])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: e3dc74e7-cc84-5926-97fb-52c9d49729c0

	measure 'Coût atelier réel' = SUM('Rentabilité tracteur'[Atelier])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 3812dfa2-989a-55a3-bfa8-a0d3510b3a47

	measure 'Marge directe' = SUM('Rentabilité tracteur'[Marge directe])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 3d28639d-df8f-5c3a-b3bc-a042de63d05b

	measure 'Marge directe %' = DIVIDE([Marge directe], [CA (tracteurs)])
		formatString: 0.0%
		displayFolder: Rentabilité
		lineageTag: 156e8582-18e6-5423-b24e-ad9e8745c2ae

	measure 'Marge directe / km' = DIVIDE([Marge directe], SUM('Rentabilité tracteur'[Km]))
		formatString: #,0.00 €
