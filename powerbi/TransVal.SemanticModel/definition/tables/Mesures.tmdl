	measure 'CA (conducteurs)' = SUM('Rentabilité conducteur'[CA])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 784f0d9a-93d4-5732-8cb5-e467eca9c746

	measure 'Salaire chargé' = SUM('Rentabilité conducteur'[Salaire chargé])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 065f5126-a682-51b0-a989-ffc0872a52d6

	measure 'Frais conducteur' = SUM('Rentabilité conducteur'[Frais])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 14e034ed-1d49-5084-8b6c-e79c60fae44b

	measure 'Carburant conducteur' = SUM('Rentabilité conducteur'[Carburant])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 566ccb63-e125-55e1-a386-0cac8b1dc89a

	measure 'Contribution conducteur' = SUM('Rentabilité conducteur'[Contribution])
		formatString: #,0 €
		displayFolder: Rentabilité
		lineageTag: 567b56a4-9872-5ec5-b05a-3f78e4eb3553

	measure 'Contribution %' = DIVIDE([Contribution conducteur], [CA (conducteurs)])
		formatString: 0.0%
		displayFolder: Rentabilité
		lineageTag: 5499188a-12b2-5f03-8aa7-9d5f0b46393d

	measure 'Contribution / heure payée' = DIVIDE([Contribution conducteur], SUM('Rentabilité conducteur'[Heures payées]))
		formatString: #,0.00 €
		displayFolder: Rentabilité
		lineageTag: 9a169802-4bfc-5d90-a9e5-4bbf71c28922

	measure 'Lignes importées' = SUM('Import'[Lignes])
		formatString: #,0
		displayFolder: Qualité des données
		lineageTag: f52413ad-0721-5bd4-8ea5-cea91e75afc9

	measure 'Lignes corrigées ou écartées' = SUM('Contrôle qualité'[Lignes concernées])
		formatString: #,0
		displayFolder: Qualité des données
		lineageTag: d4708d93-c9cb-51a2-b229-27d5778abbe4

	measure 'Nb tests dbt' = CALCULATE(COUNTROWS('Résultat dbt'), 'Résultat dbt'[Type nœud] = "test")
		formatString: #,0
		displayFolder: Qualité des données
		lineageTag: 5f3d0133-97c3-5fda-a8f4-0f6f7392d9e5

	measure 'Nb tests réussis' = CALCULATE([Nb tests dbt], 'Résultat dbt'[Statut] = "pass")
		formatString: #,0
		displayFolder: Qualité des données
		lineageTag: 0dec7cbe-1bb5-5c00-ac46-f4b3bf3e43cb

	measure 'Taux de tests réussis' = DIVIDE([Nb tests réussis], [Nb tests dbt])
		formatString: 0.0%
		displayFolder: Qualité des données
		lineageTag: 02c85786-e5fa-5229-ac47-cd122fda0e4a

	measure 'Nb changements de contrat' = CALCULATE(COUNTROWS('Historique conducteur'), NOT 'Historique conducteur'[Version courante])
		formatString: #,0
		displayFolder: Qualité des données
		lineageTag: ce39c383-a8c6-5799-a34a-c811ff83597b

	measure 'Nb voyages de la semaine' =
			VAR sem = IF(HASONEVALUE('Date'[Année semaine n°]), VALUES('Date'[Année semaine n°]), CALCULATE(MAX('Date'[Année semaine n°]), 'Date'[Est passé]))
			RETURN CALCULATE([Nb voyages], 'Date'[Année semaine n°] = sem)
		formatString: #,0
		displayFolder: Activité
		lineageTag: 91339521-3b4c-533a-9309-a0ef3d2556f3

	measure 'CA de la semaine' =
			VAR sem = IF(HASONEVALUE('Date'[Année semaine n°]), VALUES('Date'[Année semaine n°]), CALCULATE(MAX('Date'[Année semaine n°]), 'Date'[Est passé]))
			RETURN CALCULATE([CA facturé], 'Date'[Année semaine n°] = sem)
		formatString: #,0 €
		displayFolder: Activité
		lineageTag: d145d072-71bd-56f0-9675-4c31efd38e7e

	measure 'Jour J+1' =
			VAR ref = [Date de référence]
			VAR j1 = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] > ref, 'Date'[Est jour ouvré])
			RETURN j1
		formatString: dd/mm/yyyy
		displayFolder: Exploitation J+1
		lineageTag: b3f4368b-b881-5128-a708-d9e43da4bb5c

	measure 'Libellé J+1' =
			VAR ref = [Date de référence]
			VAR j1 = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] > ref, 'Date'[Est jour ouvré])
			RETURN "Préparation du " & FORMAT(j1, "dddd d mmmm yyyy") & "  ·  situation arrêtée au " & FORMAT(ref, "dd/mm/yyyy")
		displayFolder: Exploitation J+1
		lineageTag: f04c613e-416a-5f62-a2d5-a682e02f9091

	measure 'Missions planifiées J+1' =
			VAR ref = [Date de référence]
			VAR j1 = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] > ref, 'Date'[Est jour ouvré])
			RETURN CALCULATE([Nb voyages], REMOVEFILTERS('Date'), 'Date'[Date] = j1) + 0
		formatString: #,0
		displayFolder: Exploitation J+1
		lineageTag: fb733928-1d21-5f6a-af9b-3a0703e37140

	measure 'CA prévu J+1' =
			VAR ref = [Date de référence]
			VAR j1 = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] > ref, 'Date'[Est jour ouvré])
			RETURN CALCULATE(SUM('Voyage'[CA facturé]), REMOVEFILTERS('Date'), 'Date'[Date] = j1) + 0
		formatString: #,0 €
		displayFolder: Exploitation J+1
		lineageTag: b100c6b0-ebb0-5569-8c81-d00e1eee9ccd

	measure 'Tracteurs engagés J+1' =
			VAR ref = [Date de référence]
			VAR j1 = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'), 'Date'[Date] > ref, 'Date'[Est jour ouvré])
			RETURN CALCULATE(DISTINCTCOUNT('Voyage'[N° tracteur]), REMOVEFILTERS('Date'), 'Date'[Date] = j1) + 0
		formatString: #,0
		displayFolder: Exploitation J+1
		lineageTag: c6eebdbe-ce87-5455-9d31-721e42b09a19

	measure 'Tracteurs en maintenance J' =
			VAR ref = [Date de référence]
			RETURN CALCULATE([Jours tracteur en maintenance], REMOVEFILTERS('Date'), REMOVEFILTERS('Activité'), REMOVEFILTERS('Conducteur'), 'Date'[Date] = ref) + 0
		formatString: #,0
		displayFolder: Exploitation J+1
		lineageTag: fd78a496-1aec-5d09-af5b-4479e2b939ec

	measure 'Tracteurs libres J+1' = MAX(0, [Parc tracteurs] - [Tracteurs en maintenance J] - [Tracteurs engagés J+1])
		formatString: #,0
		displayFolder: Exploitation J+1
		lineageTag: 1d9b9453-83a4-5755-b627-d701db0e269f

	measure 'Taux d''engagement flotte J+1' = DIVIDE([Tracteurs engagés J+1], [Parc tracteurs] - [Tracteurs en maintenance J])
		formatString: 0.0%
		displayFolder: Exploitation J+1
		lineageTag: aaf9fa90-a3a8-5539-a1b5-a5e5b22b9cb3

	measure 'Conducteurs sans mission J+1' = MAX(0, [Nb chauffeurs] - [Nb absents du jour] - [Tracteurs engagés J+1])
		formatString: #,0
		displayFolder: Exploitation J+1
		lineageTag: 3917b26a-99cc-51bc-a44a-a912e137debc

	measure 'CA du jour' =
			VAR ref = [Date de référence]
			RETURN CALCULATE([CA facturé], REMOVEFILTERS('Date'), 'Date'[Date] = ref)
		formatString: #,0 €
		displayFolder: Exploitation J+1
		lineageTag: 0bd63ee0-24cc-5f86-999a-93ed5ce334cd

	measure 'Appairage du jour' =
			VAR ref = [Date de référence]
			RETURN CALCULATE([Appairage], REMOVEFILTERS('Date'), 'Date'[Date] = ref)
		formatString: 0.0%
		displayFolder: Exploitation J+1
		lineageTag: 0552a062-5807-5da9-bb2e-054f6d9a3e4c

	measure 'Étiquette indicateur activité' = SWITCH(SELECTEDVALUE('Sélecteur activité'[Indicateur]), "CA", FORMAT([CA facturé] / 1000000, "0.00") & " M€", "CA / jour ouvré", FORMAT([CA moyen / jour ouvré] / 1000, "0.0") & " k€", "MCV %", FORMAT([MCV %], "0.0 %"), "Appairage", FORMAT([Appairage], "0.0 %"))
		displayFolder: Sélecteurs
		lineageTag: 08264f17-e3fb-564b-a840-f86bba56b2dd

	measure 'Étiquette indicateur coût' = SWITCH(SELECTEDVALUE('Sélecteur coût'[Indicateur]), "Salaire brut / HP", FORMAT([Salaire brut / heure prod], "0.00") & " €", "Frais & primes / HP", FORMAT([Frais & primes / HP], "0.00") & " €", "Passages autoroute interdite / voyage", FORMAT([Passages autoroute interdite / voyage], "0.000"), "HCHC / voyage", FORMAT([HCHC / voyage], "0.00") & " h")
		displayFolder: Sélecteurs
		lineageTag: 2dad1c92-18b2-5f0d-b6e9-ae5748b6f62f

	measure 'Étiquette indicateur anomalies' = SWITCH(SELECTEDVALUE('Sélecteur anomalies'[Indicateur]), "Anomalies à traiter", FORMAT([Anomalies à traiter] + 0, "0"), "Anomalies en cours", FORMAT([Anomalies en cours] + 0, "0"), "Anomalies traitées 7 derniers jours", FORMAT([Anomalies traitées 7 derniers jours] + 0, "0"))
		displayFolder: Sélecteurs
		lineageTag: 2aacc342-1b89-568c-ba94-3d774f7b7b52

	measure 'Pictogramme info' = UNICHAR(9432)
		displayFolder: Calendrier
		lineageTag: 1e199f04-a79c-540e-a1d0-e73deb00c42e

	column Colonne
		dataType: string
		isHidden
		lineageTag: cf2a825a-6715-5bb4-819c-71df06ea2fb0
		summarizeBy: none
		sourceColumn: [Colonne]

	partition Mesures = calculated
		mode: import
		source = DATATABLE("Colonne", STRING, {{""}})

