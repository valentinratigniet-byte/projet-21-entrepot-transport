	measure 'Heures compensées (base contrat)' =
			VAR ref = [Date de référence]
			VAR debut = DATE(YEAR(ref), MONTH(ref), 1)
			VAR limite = IF(DAY(ref) >= 10, debut, EDATE(debut, -1))  -- mois clos à partir du 10
			RETURN CALCULATE(SUM('Compteur paie'[Heures compensées]), 'Compteur paie'[Mois] < limite)
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 8bd3e6ba-97cb-539a-bf78-18e891bea88b

	measure 'Heures compensées €' = [Heures compensées (base contrat)] * [Salaire brut / heure prod]
		formatString: #,0 €
		displayFolder: Heures conducteurs
		lineageTag: 909995d2-3417-5cde-a5d5-0c8010132638

	measure 'Heures compensées € / HP' = DIVIDE([Heures compensées €], [Heures prod])
		formatString: #,0.00 €
		displayFolder: Heures conducteurs
		lineageTag: ee0556e2-32a8-5afb-baf7-24bd9e866e73

	measure 'Heures à justifier payées' = CALCULATE(SUM('Pointage'[Heures]), 'Pointage'[Est valide], 'Pointage'[Catégorie HCHC] = "a_justifier")
		formatString: #,0.0
		displayFolder: Heures conducteurs
		lineageTag: 6aae77ab-cae3-547a-9480-803f448e87ee

	measure 'Heures à justifier payées €' = [Heures à justifier payées] * [Salaire brut / heure prod]
		formatString: #,0 €
