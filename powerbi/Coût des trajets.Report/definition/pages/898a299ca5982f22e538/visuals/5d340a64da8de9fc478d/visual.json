                      "fontSize": "9pt",
                      "color": "#1C2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Coût total chargé = (gazole + maintenance + pneus) × km + heures de conduite × coût conducteur. ",
