                      "fontSize": "9pt",
                      "color": "#1C2733",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Coût conducteur / h : ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "salaire conventionnel + charges patronales + frais de route, ramenés à l'heure de service ; revalorisé d'environ 3 % par an.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Gazole + AdBlue / km : ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "consommation moyenne (~33 L/100 km) × prix moyen HT du gazole de l'année, + ~5 % d'AdBlue ; suit le prix du carburant (repli depuis 2023).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Maintenance / km : ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "entretien préventif et réparations (pièces + main-d'œuvre atelier) du parc, rapportés aux kilomètres parcourus.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Pneus / km : ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1C2733",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "achat et rechapage des pneumatiques rapportés à leur durée de vie en kilomètres.",
